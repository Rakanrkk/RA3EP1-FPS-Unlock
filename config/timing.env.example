# RA3EP1 FPS Unlock 1.0.0 - runtime switches
#
# The payload reads no configuration files. These process environment
# variables are the only runtime switches; the loader and the game inherit
# them from the shell that starts the loader.

# U60_BASELINE
#   When set to a non-empty value, the payload keeps the engine at its native
#   30 FPS timing, installs only the display counter hooks, and logs
#   baseline-only measurements. Unset (or empty) enables the selected rate.
#   Example (Windows): set U60_BASELINE=1
U60_BASELINE=
